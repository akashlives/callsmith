        "required": ["meeting_id", "summary", "status", "request_id"],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "untrustedContentHint": false
      },
      "action": {
        "kind": "append",
        "collection": "tasks",
        "fields": {
          "meetingId": "meeting_id",
          "summary": "summary",
          "status": "status"
        },
        "idPrefix": "task",
        "idempotencyArgument": "request_id",
        "requireConfirmation": false
      }
    },
    {
      "name": "send_reply",
      "title": "Send renewal reply",
      "description": "Send the synthetic renewal reply only after a human confirms the consequential action.",
