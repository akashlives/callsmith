# Public URL used in report links and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Worker-only credential for the canonical hosted model. Never configure this on web.
OPENAI_API_KEY=

# Production adapters. Local development uses isolated in-memory stores when omitted.
DATABASE_URL=
REDIS_URL=

# Shared internal worker authentication.
CALLSMITH_RUNNER_TOKEN=
CALLSMITH_PUBLIC_URL=http://localhost:3000
CALLSMITH_WEB_INTERNAL_URL=http://localhost:3000

# Select `chrome-dev` for the pinned Linux unstable package or `chrome` when
# intentionally verifying an eligible stable installation.
CALLSMITH_CHROME_CHANNEL=chrome-dev
CALLSMITH_PROCESS_TYPE=web

# Optional Pipedream Connect write backend. Guest CTA stays synthetic.
# Live Connect requires all three; otherwise catalog / visual only.
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=

# Local /r screenshot helper. Ignored in production. Defaults to receipt-e2e in development.
# CALLSMITH_VISUAL_RECEIPT_TOKEN=receipt-e2e
