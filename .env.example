# Public URL used in report links and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional hosted model key. Without it Callsmith stays honest and serves preview mode.
OPENAI_API_KEY=

# Production adapters. Local development uses isolated in-memory stores when omitted.
DATABASE_URL=
REDIS_URL=

# Reserved for the queued-worker BYOK envelope; the current vertical slice keeps
# request-scoped BYOK only in memory and never persists it.
BYOK_ENCRYPTION_KEY=

# Reserved for the provisioned private artifact bucket adapter.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=
