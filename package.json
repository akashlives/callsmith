{
  "name": "callsmith",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node scripts/browser-worker.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "static": "knip && node scripts/check-reset.mjs",
    "framework:manifest": "node scripts/framework-manifest.mjs",
    "smoke:webmcp": "node scripts/run-official-smoke.mjs",
    "benchmark:browser": "node scripts/run-benchmark.mjs",
    "verify": "npm run static && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "typecheck": "tsc --noEmit"
  },
  "knip": {
    "entry": [
      "src/**/*.test.{ts,tsx}",
      "tests/**/*.test.{ts,tsx}",
      "tests/e2e/**/*.spec.ts",
      "scripts/actuation-probe.mjs"
    ],
    "project": [
      "scripts/**/*.{mjs,js}",
      "src/**/*.{ts,tsx}",
      "tests/**/*.{ts,tsx}"
    ],
    "ignoreDependencies": ["tailwindcss"]
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.109",
    "ai": "7.0.163",
    "ioredis": "6.0.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "webmcp-evals": "0.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "knip": "6.44.1",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
