{
  "name": "callsmith",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node scripts/browser-worker.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "static": "knip && node scripts/check-reset.mjs",
    "framework:manifest": "node scripts/framework-manifest.mjs",
    "smoke:webmcp": "node scripts/run-official-smoke.mjs",
    "benchmark:browser": "node scripts/run-benchmark.mjs",
    "verify": "npm run static && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "typecheck": "tsc --noEmit"
  },
  "knip": {
    "entry": [
      "src/**/*.test.{ts,tsx}",
      "tests/**/*.test.{ts,tsx}",
      "tests/e2e/**/*.spec.ts"
    ],
    "project": [
      "scripts/**/*.{mjs,js}",
      "src/**/*.{ts,tsx}",
      "tests/**/*.{ts,tsx}"
    ],
    "ignoreDependencies": [
      "webmcp-evals",
      "tailwindcss"
    ]
  },
  "dependencies": {
    "ioredis": "6.0.0",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "webmcp-evals": "0.0.4",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "knip": "6.33.0",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
